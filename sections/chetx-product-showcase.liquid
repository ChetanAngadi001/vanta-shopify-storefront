
{% liquid
  assign selected_collection = section.settings.collection
%}

<section
  id="CHETX-Showcase-{{ section.id }}"
  class="chetx-showcase"
  style="
    --cs-bg: {{ section.settings.background_color }};
    --cs-text: {{ section.settings.text_color }};
    --cs-accent: {{ section.settings.accent_color }};
  "
>
  <div class="chetx-showcase__inner">

    <header class="chetx-showcase__header">
      <div>
        <span class="chetx-showcase__eyebrow">
          {{ section.settings.eyebrow }}
        </span>

        <h2>{{ section.settings.heading }}</h2>

        {% if section.settings.description != blank %}
          <p>{{ section.settings.description }}</p>
        {% endif %}
      </div>

      {% if section.settings.show_view_all and selected_collection != blank %}
        <a class="chetx-showcase__view-all" href="{{ selected_collection.url }}">
          VIEW ALL <span>↗</span>
        </a>
      {% endif %}
    </header>

    {% if selected_collection != blank and selected_collection.products.size > 0 %}

      <div class="chetx-showcase__grid">

        {% for product in selected_collection.products limit: section.settings.products_to_show %}

          <article class="chetx-product-card">

            <div class="chetx-product-card__media">

              {% if product.featured_image %}
                <img
                  class="chetx-product-card__image"
                  src="{{ product.featured_image | image_url: width: 1200 }}"
                  alt="{{ product.featured_image.alt | default: product.title | escape }}"
                  loading="lazy"
                  width="{{ product.featured_image.width }}"
                  height="{{ product.featured_image.height }}"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'chetx-product-card__image placeholder' }}
              {% endif %}

              {% if section.settings.hover_image and product.images.size > 1 %}
                <img
                  class="chetx-product-card__image chetx-product-card__image--hover"
                  src="{{ product.images[1] | image_url: width: 1200 }}"
                  alt="{{ product.title | escape }}"
                  loading="lazy"
                  width="{{ product.images[1].width }}"
                  height="{{ product.images[1].height }}"
                >
              {% endif %}

              {% if product.compare_at_price > product.price %}
                <span class="chetx-product-card__badge">SALE</span>
              {% endif %}

              <span class="chetx-product-card__index">
                0{{ forloop.index }}
              </span>

              {% if product.available %}
                <div class="chetx-product-card__cart-wrap">

                  <button
                    type="button"
                    class="chetx-product-card__cart"
                    aria-label="Choose size for {{ product.title | escape }}"
                    aria-expanded="false"
                    aria-controls="VantaSizes-{{ section.id }}-{{ product.id }}"
                  >
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M3 3h2l2.4 12.2a2 2 0 0 0 2 1.6h8.8a2 2 0 0 0 2-1.6L22 8H6"/>
                      <circle cx="10" cy="20" r="1"/>
                      <circle cx="19" cy="20" r="1"/>
                    </svg>
                  </button>

                  <div
                    class="chetx-product-card__size-menu"
                    id="VantaSizes-{{ section.id }}-{{ product.id }}"
                    hidden
                  >


                    {% for variant in product.variants %}
                      <button
                        type="button"
                        class="chetx-product-card__size-option"
                        data-variant-id="{{ variant.id }}"
                        {% unless variant.available %}disabled{% endunless %}
                      >
                        {{ variant.title }}
                      </button>
                    {% endfor %}

                    <span class="chetx-product-card__size-message" aria-live="polite"></span>
                  </div>

                </div>
              {% else %}
                <span class="chetx-product-card__sold-out">SOLD OUT</span>
              {% endif %}

            </div>

            <div class="chetx-product-card__details">

              <div>
                {% if section.settings.show_vendor %}
                  <span class="chetx-product-card__vendor">
                    {{ product.vendor }}
                  </span>
                {% endif %}

                <h3>
                  <a href="{{ product.url }}">{{ product.title }}</a>
                </h3>
              </div>

              <div class="chetx-product-card__price">
                {% if product.compare_at_price > product.price %}
                  <s>{{ product.compare_at_price | money }}</s>
                {% endif %}
                <span>{{ product.price | money }}</span>
              </div>

            </div>

          </article>

        {% endfor %}

      </div>

    {% else %}

      <div class="chetx-showcase__empty">
        <span>COLLECTION NOT SELECTED</span>
        <p>Choose a Shopify collection in this section's settings.</p>
      </div>

    {% endif %}

    <div class="chetx-showcase__footer">
      <span>VANTA® — NOT MADE TO FIT IN.</span>
      <span>DESIGNED FOR THE DIFFERENT.</span>
    </div>

  </div>
</section>


<style>
  /* =========================================
     VANTA PRODUCT SHOWCASE
  ========================================= */

  #CHETX-Showcase-{{ section.id }} {
  background: var(--cs-bg);
  color: var(--cs-text);
  padding: 100px 5% 55px;
  overflow: hidden;
}

  #CHETX-Showcase-{{ section.id }} .chetx-showcase__inner {
    max-width: 1600px;
    margin: 0 auto;
  }

  /* HEADER */

  #CHETX-Showcase-{{ section.id }} .chetx-showcase__header {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 30px;
    margin-bottom: 48px;
  }

  #CHETX-Showcase-{{ section.id }} .chetx-showcase__eyebrow {
    color: var(--cs-accent);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 4px;
  }

  #CHETX-Showcase-{{ section.id }} h2 {
    color: var(--cs-text);
    font-size: clamp(38px, 6vw, 82px);
    font-weight: 900;
    line-height: .95;
    letter-spacing: -4px;
    text-transform: uppercase;
    margin: 20px 0;
  }

  #CHETX-Showcase-{{ section.id }} .chetx-showcase__header p {
    color: #999;
    font-size: 14px;
    max-width: 420px;
    line-height: 1.7;
  }

  #CHETX-Showcase-{{ section.id }} .chetx-showcase__view-all {
    color: var(--cs-text);
    border-bottom: 1px solid var(--cs-accent);
    padding-bottom: 10px;
    text-decoration: none;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
    white-space: nowrap;
  }

  #CHETX-Showcase-{{ section.id }} .chetx-showcase__view-all span {
    color: var(--cs-accent);
    margin-left: 10px;
  }

  /* PRODUCT GRID */

 #CHETX-Showcase-{{ section.id }} .chetx-showcase__grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  column-gap: 34px;
row-gap: 40px;
}

  #CHETX-Showcase-{{ section.id }} .chetx-product-card {
    position: relative;
  }

  /* PRODUCT IMAGE */

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__media {
  position: relative;
  display: block;
  overflow: visible;
  background: #191919;
  aspect-ratio: 4 / 5;
  isolation: isolate;
}

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  clip-path: inset(0);
}

  /* BLURRED BACKGROUND IMAGE */

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__image--hover {
  z-index: 0;
  opacity: 1;
  filter: blur(18px);
  transform: scale(1.08);
  clip-path: inset(0);
  transition:
    filter .7s ease,
    transform .7s ease;
}

  /* FOREGROUND PRODUCT IMAGE */

  /* FOREGROUND PRODUCT IMAGE */

#CHETX-Showcase-{{ section.id }} .chetx-product-card__image:not(.chetx-product-card__image--hover) {
  z-index: 1;

  width: 88%;
  height: 88%;

  top: 50%;
  left: 50%;
  right: auto;
  bottom: auto;

  object-fit: contain;

  opacity: 1;
  transform: translate(-50%, -50%) scale(1);

  transition:
  transform .25s ease,
  opacity .25s ease;
}

  /* REVEAL LIFESTYLE IMAGE ON HOVER */

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__media:hover .chetx-product-card__image--hover {
    filter: blur(0);
    transform: scale(1);
  }

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__media:hover .chetx-product-card__image:not(.chetx-product-card__image--hover) {
  opacity: 0;
  transform: translate(-50%, -50%) scale(.94);
}

  /* SALE BADGE */

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__badge {
    position: absolute;
    top: 15px;
    left: 15px;
    z-index: 3;
    background: var(--cs-accent);
    color: #090909;
    padding: 8px 12px;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 1px;
  }

  /* PRODUCT INDEX */

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__index {
    position: absolute;
    bottom: 15px;
    left: 15px;
    z-index: 3;
    color: white;
    font-size: 11px;
    letter-spacing: 2px;
  }

  /* CART ICON WRAPPER */

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__cart-wrap {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 10;
  }

  /* CART ICON */

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__cart {
    position: relative;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: #fff;
    color: #050505;
    border: 0;
    border-radius: 5px;
    cursor: pointer;
    transition:
      background .25s ease,
      transform .25s ease;
  }

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__cart:hover,
  #CHETX-Showcase-{{ section.id }} .chetx-product-card__cart[aria-expanded="true"] {
    background: var(--cs-accent);
    transform: translateY(-2px);
  }

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__cart svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* =========================================
     SIZE DROPDOWN - SMOOTH ANIMATION
  ========================================= */

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__size-menu {
    position: absolute;
    top: 52px;
    right: 0;

    width: 44px;
    min-width: 44px;
    padding: 5px 3px;

    display: flex;
    flex-direction: column;
    gap: 2px;

    background: #fff;
    border: 1px solid #ddd;
    box-shadow: 0 12px 30px rgba(0,0,0,.25);

    box-sizing: border-box;
    z-index: 20;

    opacity: 0;
    visibility: hidden;
    transform: translateY(-12px);
    pointer-events: none;

    transition:
      opacity .35s ease,
      transform .35s cubic-bezier(.22, 1, .36, 1),
      visibility 0s linear .35s;
  }

  /* OPEN STATE */

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__size-menu.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;

    transition:
      opacity .35s ease,
      transform .35s cubic-bezier(.22, 1, .36, 1),
      visibility 0s;
  }

  /* HIDDEN STATE */

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__size-menu[hidden] {
    display: none !important;
  }

  /* SIZE OPTIONS */

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__size-option {
  width: 100%;
  height: 26px;
  min-height: 26px;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: #fff;
  color: #050505;
  border: 0;
  font-size: 11px;
  font-weight: 800;
  text-align: center;
  cursor: pointer;
  transition: background .2s ease, color .2s ease;
}

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__size-option:hover:not(:disabled) {
    background: var(--cs-accent);
    color: #050505;
  }

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__size-option:disabled {
    opacity: .35;
    cursor: not-allowed;
  }

  /* SUCCESS TICK */

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__size-option span {
    color: #050505;
    font-size: 17px;
    font-weight: 900;
  }

  /* SOLD OUT */

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__sold-out {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 4;
    background: #222;
    color: #aaa;
    padding: 12px;
    font-size: 10px;
    font-weight: 900;
  }

 /* PRODUCT DETAILS — VANTA FINAL */

#CHETX-Showcase-{{ section.id }} .chetx-product-card__details {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 3px;
  padding-top: 16px;
}

#CHETX-Showcase-{{ section.id }} .chetx-product-card__details h3 {
  font-size: 13px;
  margin: 0;
  font-weight: 700;
  line-height: 1.4;
  letter-spacing: .2px;
}

#CHETX-Showcase-{{ section.id }} .chetx-product-card__details h3 a {
  color: var(--cs-text);
  text-decoration: none;
  transition: color .25s ease;
}

#CHETX-Showcase-{{ section.id }} .chetx-product-card__details h3 a:hover {
  color: var(--cs-accent);
}

#CHETX-Showcase-{{ section.id }} .chetx-product-card__price {
  font-size: 13px;
  font-weight: 700;
  white-space: nowrap;
  padding-top: 0;
  line-height: 1.5;
}

#CHETX-Showcase-{{ section.id }} .chetx-product-card__price s {
  color: #777;
  font-size: 11px;
  font-weight: 400;
  margin-right: 7px;
}
  /* EMPTY COLLECTION */

  #CHETX-Showcase-{{ section.id }} .chetx-showcase__empty {
    padding: 90px 20px;
    border: 1px dashed #555;
    text-align: center;
  }

  #CHETX-Showcase-{{ section.id }} .chetx-showcase__empty span {
    color: var(--cs-accent);
    letter-spacing: 3px;
    font-weight: 800;
  }

  /* FOOTER */

  #CHETX-Showcase-{{ section.id }} .chetx-showcase__footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    border-top: 1px solid #333;
    margin-top: 65px;
    padding-top: 20px;
    color: #888;
    font-size: 9px;
    letter-spacing: 2px;
  }

  /* MOBILE */

  @media (max-width: 749px) {
    #CHETX-Showcase-{{ section.id }} {
      padding: 65px 5%;
    }

    #CHETX-Showcase-{{ section.id }} .chetx-showcase__header {
      align-items: start;
      flex-direction: column;
      margin-bottom: 30px;
    }

    #CHETX-Showcase-{{ section.id }} h2 {
      font-size: 43px;
      letter-spacing: -2px;
    }

    #CHETX-Showcase-{{ section.id }} .chetx-showcase__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px 10px;
    }

    #CHETX-Showcase-{{ section.id }} .chetx-product-card__details {
      flex-direction: column;
      gap: 3px;
    }

    #CHETX-Showcase-{{ section.id }} .chetx-showcase__footer {
      flex-direction: column;
      margin-top: 40px;
    }
  }

  /* REDUCED MOTION ACCESSIBILITY */

  @media (prefers-reduced-motion: reduce) {
    #CHETX-Showcase-{{ section.id }} *,
    #CHETX-Showcase-{{ section.id }} *::before,
    #CHETX-Showcase-{{ section.id }} *::after {
      transition: none !important;
    }
  }

  /* VANTA MOBILE PRODUCT ALIGNMENT */

@media screen and (max-width: 749px) {

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__details {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__details h3 {
    min-height: 2.8em;
margin-bottom: 0;
    line-height: 1.4;
  }

  #CHETX-Showcase-{{ section.id }} .chetx-product-card__price {
    margin-top: 2px;
  }

}

</style>




<script>
(() => {
  const section = document.getElementById('CHETX-Showcase-{{ section.id }}');
  if (!section || section.dataset.vantaCartReady) return;

  section.dataset.vantaCartReady = 'true';

  // Smoothly open a dropdown
  function openMenu(menu, button) {
    clearTimeout(menu.closeTimer);

    menu.hidden = false;
    void menu.offsetHeight;

    requestAnimationFrame(() => {
      menu.classList.add('is-open');
    });

    button.setAttribute('aria-expanded', 'true');
  }

  // Smoothly close a dropdown
  function closeMenu(menu) {
    clearTimeout(menu.closeTimer);

    menu.classList.remove('is-open');

    const button = menu.closest('.chetx-product-card__cart-wrap')
      ?.querySelector('.chetx-product-card__cart');

    if (button) {
      button.setAttribute('aria-expanded', 'false');
    }

    menu.closeTimer = setTimeout(() => {
      if (!menu.classList.contains('is-open')) {
        menu.hidden = true;
      }
    }, 300);
  }

  // Save original size labels
  section.querySelectorAll('.chetx-product-card__size-option').forEach((button) => {
    button.dataset.originalLabel = button.textContent.trim();
  });

  section.addEventListener('click', async (event) => {

    // CART BUTTON CLICK
    const cartButton = event.target.closest('.chetx-product-card__cart');

    if (cartButton && section.contains(cartButton)) {
      event.preventDefault();

      const wrap = cartButton.closest('.chetx-product-card__cart-wrap');
      const menu = wrap.querySelector('.chetx-product-card__size-menu');
      const willOpen = menu.hidden || !menu.classList.contains('is-open');

      // Close other menus only, not the one being opened
      section.querySelectorAll('.chetx-product-card__size-menu').forEach((item) => {
        if (item !== menu) {
          closeMenu(item);
        }
      });

      if (willOpen) {
        openMenu(menu, cartButton);
      } else {
        closeMenu(menu);
      }

      return;
    }

    // SIZE BUTTON CLICK
    const sizeButton = event.target.closest('.chetx-product-card__size-option');

    if (sizeButton && section.contains(sizeButton)) {
      event.preventDefault();

      if (sizeButton.disabled) return;

      const variantId = sizeButton.dataset.variantId;
      sizeButton.disabled = true;

      try {
        const response = await fetch(
          `${window.Shopify.routes.root}cart/add.js`,
          {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Accept': 'application/json'
            },
            body: JSON.stringify({
              id: Number(variantId),
              quantity: 1
            })
          }
        );

        const result = await response.json();

        if (!response.ok) {
          throw new Error(result.description || 'Unable to add item');
        }

        // Show tick without changing the dropdown size
        sizeButton.innerHTML = '<span>✓</span>';

        // Restore original size after 2 seconds
        setTimeout(() => {
          sizeButton.textContent = sizeButton.dataset.originalLabel;
          sizeButton.disabled = false;

          const menu = sizeButton.closest('.chetx-product-card__size-menu');
          closeMenu(menu);
        }, 2000);

        // Update cart count
        const cartResponse = await fetch(
          `${window.Shopify.routes.root}cart.js`,
          { headers: { 'Accept': 'application/json' } }
        );

        if (cartResponse.ok) {
          const cart = await cartResponse.json();

          document.querySelectorAll('[data-cart-count]').forEach((item) => {
            item.textContent = cart.item_count;
          });

          document.querySelectorAll('.cart-count-bubble').forEach((bubble) => {
            bubble.classList.toggle('hidden', cart.item_count === 0);

            const count = bubble.querySelector('span[aria-hidden="true"]');
            if (count) count.textContent = cart.item_count;
          });
        }

        document.dispatchEvent(new CustomEvent('cart:updated'));

      } catch (error) {
        alert(error.message);

        sizeButton.textContent = sizeButton.dataset.originalLabel;
        sizeButton.disabled = false;
      }
    }
  });

  // Close menus when clicking outside
  document.addEventListener('click', (event) => {
    if (!section.contains(event.target)) {
      section.querySelectorAll('.chetx-product-card__size-menu').forEach((menu) => {
        closeMenu(menu);
      });
    }
  });

})();
</script>



{% schema %}
{
  "name": "CHETX Product Showcase",
  "tag": "section",
  "class": "section-chetx-showcase",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small label",
      "default": "VANTA / SELECTED PIECES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "THE NEW UNIFORM."
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Pieces made for those who refuse to blend in. Discover the VANTA collection."
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Choose collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Number of products",
      "min": 4,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "hover_image",
      "label": "Show second image on hover",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "Show product vendor",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": true
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0B0B0B"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#F5F5F5"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#B5FF35"
    }
  ],
  "presets": [
    {
      "name": "CHETX Product Showcase"
    }
  ]
}
{% endschema %}
