
{% liquid
  assign has_mobile_video = false
  if section.settings.mobile_video != blank
    assign has_mobile_video = true
  endif
%}

<section
  id="VantaHero-{{ section.id }}"
  class="vanta-hero {% if has_mobile_video %}has-mobile-video{% endif %}"
  style="
    --hero-height: {{ section.settings.hero_height }}px;
    --hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hero-overlay-color: {{ section.settings.overlay_color }};
    --hero-text-color: {{ section.settings.text_color }};
    --hero-accent: {{ section.settings.accent_color }};
  "
>
  <div class="vanta-hero__media">

    {% if section.settings.desktop_video != blank %}

      <div class="vanta-hero__video-wrap">
        {{
          section.settings.desktop_video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true
        }}
      </div>

    {% elsif section.settings.desktop_image != blank %}

      {{
        section.settings.desktop_image
        | image_url: width: 2400
        | image_tag:
          class: 'vanta-hero__image',
          loading: 'eager',
          fetchpriority: 'high'
      }}

    {% endif %}

    {% if has_mobile_video %}
      <div class="vanta-hero__mobile-video">
        {{
          section.settings.mobile_video
          | video_tag:
            autoplay: true,
            loop: true,
            muted: true,
            controls: false,
            playsinline: true
        }}
      </div>
    {% endif %}

    {% if section.settings.desktop_video == blank and section.settings.desktop_image == blank %}
      <div class="vanta-hero__placeholder"></div>
    {% endif %}

    <div class="vanta-hero__overlay"></div>
  </div>

  <div class="vanta-hero__content vanta-hero__content--{{ section.settings.content_position }} vanta-hero__align--{{ section.settings.text_alignment }}">

    {% if section.settings.eyebrow != blank %}
      <p class="vanta-hero__eyebrow">
        {{ section.settings.eyebrow | escape }}
      </p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="vanta-hero__heading">
        {{ section.settings.heading | escape }}
      </h1>
    {% endif %}

    {% if section.settings.subheading != blank %}
      <p class="vanta-hero__subheading">
        {{ section.settings.subheading | escape }}
      </p>
    {% endif %}

    {% if section.settings.button_label != blank or section.settings.secondary_button_label != blank %}
      <div class="vanta-hero__buttons">

        {% if section.settings.button_label != blank %}
          <a
            class="vanta-hero__button vanta-hero__button--primary"
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          >
            {{ section.settings.button_label | escape }}
            <span aria-hidden="true">↗</span>
          </a>
        {% endif %}

        {% if section.settings.secondary_button_label != blank %}
          <a
            class="vanta-hero__button vanta-hero__button--secondary"
            href="{{ section.settings.secondary_button_link | default: routes.all_products_collection_url }}"
          >
            {{ section.settings.secondary_button_label | escape }}
          </a>
        {% endif %}

      </div>
    {% endif %}

  </div>

  {% if section.settings.show_scroll_indicator %}
    <div class="vanta-hero__scroll">
      <span></span>
      <p>SCROLL TO EXPLORE</p>
    </div>
  {% endif %}
</section>

<style>
  #VantaHero-{{ section.id }} {
    position: relative;
    min-height: var(--hero-height);
    height: min(var(--hero-height), 90vh);
    width: 100%;
    overflow: hidden;
    background: #101010;
    color: var(--hero-text-color);
    isolation: isolate;
  }

  #VantaHero-{{ section.id }} .vanta-hero__media,
  #VantaHero-{{ section.id }} .vanta-hero__video-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #VantaHero-{{ section.id }} .vanta-hero__media video,
  #VantaHero-{{ section.id }} .vanta-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #VantaHero-{{ section.id }} .vanta-hero__mobile-video {
    display: none;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  #VantaHero-{{ section.id }} .vanta-hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--hero-overlay-color);
    opacity: var(--hero-overlay);
    pointer-events: none;
  }

  #VantaHero-{{ section.id }} .vanta-hero__placeholder {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 70% 30%, #343434 0%, transparent 45%),
      linear-gradient(120deg, #090909, #252525, #080808);
  }

  #VantaHero-{{ section.id }} .vanta-hero__content {
    position: absolute;
    z-index: 2;
    width: min(90%, 1100px);
    padding: 50px 0;
    animation: vantaHeroReveal 1s ease both;
  }

  #VantaHero-{{ section.id }} .vanta-hero__content--middle-left {
    top: 50%;
    left: 8%;
    transform: translateY(-50%);
  }

  #VantaHero-{{ section.id }} .vanta-hero__content--middle-center {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  #VantaHero-{{ section.id }} .vanta-hero__content--bottom-left {
    bottom: 5%;
    left: 8%;
  }

  #VantaHero-{{ section.id }} .vanta-hero__content--bottom-center {
    bottom: 5%;
    left: 50%;
    transform: translateX(-50%);
  }

  #VantaHero-{{ section.id }} .vanta-hero__align--left {
    text-align: left;
  }

  #VantaHero-{{ section.id }} .vanta-hero__align--center {
    text-align: center;
  }

  #VantaHero-{{ section.id }} .vanta-hero__eyebrow {
    margin: 0 0 20px;
    color: var(--hero-accent);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  #VantaHero-{{ section.id }} .vanta-hero__heading {
    max-width: 950px;
    margin: 0;
    color: var(--hero-text-color);
    font-size: clamp(42px, 8vw, 104px);
    font-weight: 900;
    line-height: 0.95;
    letter-spacing: -0.065em;
    text-transform: uppercase;
    overflow-wrap: anywhere;
  }

  #VantaHero-{{ section.id }} .vanta-hero__subheading {
    margin: 24px 0 0;
    color: var(--hero-text-color);
    font-size: clamp(13px, 1.5vw, 18px);
    line-height: 1.6;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  #VantaHero-{{ section.id }} .vanta-hero__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 34px;
  }

  #VantaHero-{{ section.id }} .vanta-hero__align--center .vanta-hero__buttons {
    justify-content: center;
  }

  #VantaHero-{{ section.id }} .vanta-hero__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
    min-height: 52px;
    padding: 15px 28px;
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-decoration: none;
    text-transform: uppercase;
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease;
  }

  #VantaHero-{{ section.id }} .vanta-hero__button:hover {
    transform: translateY(-4px);
  }

  #VantaHero-{{ section.id }} .vanta-hero__button--primary {
    background: var(--hero-accent);
    color: #101010;
  }

  #VantaHero-{{ section.id }} .vanta-hero__button--primary:hover {
    background: #fff;
  }

  #VantaHero-{{ section.id }} .vanta-hero__button--secondary {
    border: 1px solid rgba(255,255,255,0.7);
    color: #fff;
    background: transparent;
  }

  #VantaHero-{{ section.id }} .vanta-hero__button--secondary:hover {
    background: #fff;
    color: #101010;
  }

  #VantaHero-{{ section.id }} .vanta-hero__scroll {
    position: absolute;
    z-index: 2;
    bottom: 24px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }

  #VantaHero-{{ section.id }} .vanta-hero__scroll span {
    display: block;
    height: 32px;
    width: 1px;
    background: var(--hero-accent);
    animation: vantaScroll 1.5s ease-in-out infinite;
  }

  #VantaHero-{{ section.id }} .vanta-hero__scroll p {
    margin: 0;
    color: #fff;
    font-size: 9px;
    letter-spacing: 0.2em;
  }

  @keyframes vantaHeroReveal {
    from {
      opacity: 0;
      filter: blur(8px);
    }
    to {
      opacity: 1;
      filter: blur(0);
    }
  }

  @keyframes vantaScroll {
    0%, 100% { transform: scaleY(0.6); }
    50% { transform: scaleY(1); }
  }

  @media screen and (max-width: 749px) {
    #VantaHero-{{ section.id }} {
      min-height: 600px;
      height: min(75vh, var(--hero-height));
    }

    #VantaHero-{{ section.id }} .vanta-hero__content {
  width: 86%;
  padding: 0;
  top: auto;
  bottom: 15%;
  left: 7%;
  transform: none;
}

    #VantaHero-{{ section.id }} .vanta-hero__content--middle-left,
    #VantaHero-{{ section.id }} .vanta-hero__content--bottom-left {
      left: 7%;
    }

    #VantaHero-{{ section.id }} .vanta-hero__content--bottom-left,
    #VantaHero-{{ section.id }} .vanta-hero__content--bottom-center {
      bottom: 12%;
    }

    #VantaHero-{{ section.id }} .vanta-hero__heading {
      font-size: clamp(42px, 12vw, 68px);
    }

    #VantaHero-{{ section.id }} .vanta-hero__subheading {
      margin-top: 16px;
      font-size: 12px;
    }

    #VantaHero-{{ section.id }} .vanta-hero__buttons {
      margin-top: 24px;
      gap: 10px;
    }

    #VantaHero-{{ section.id }} .vanta-hero__button {
      min-height: 46px;
      padding: 12px 18px;
      font-size: 10px;
    }

    #VantaHero-{{ section.id }}.has-mobile-video .vanta-hero__video-wrap {
      display: none;
    }

    #VantaHero-{{ section.id }}.has-mobile-video .vanta-hero__mobile-video {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #VantaHero-{{ section.id }} *,
    #VantaHero-{{ section.id }} *::before,
    #VantaHero-{{ section.id }} *::after {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

{% schema %}
{
  "name": "CHETX Video Hero",
  "tag": "section",
  "class": "section-chet-x-video-hero",
  "settings": [
    {
      "type": "header",
      "content": "Desktop media"
    },
    {
      "type": "video",
      "id": "desktop_video",
      "label": "Desktop background video"
    },
    {
      "type": "image_picker",
      "id": "desktop_image",
      "label": "Fallback or background image"
    },
    {
      "type": "header",
      "content": "Mobile media"
    },
    {
      "type": "video",
      "id": "mobile_video",
      "label": "Mobile background video (optional)"
    },
    {
      "type": "header",
      "content": "Hero content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small top text",
      "default": "VANTA — NEW COLLECTION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "NOT MADE TO FIT IN."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtitle",
      "default": "BUILT FOR THE DIFFERENT."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button",
      "default": "EXPLORE COLLECTION"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "hero_height",
      "label": "Desktop hero height",
      "min": 500,
      "max": 1000,
      "step": 50,
      "unit": "px",
      "default": 800
    },
    {
      "type": "select",
      "id": "content_position",
      "label": "Content position",
      "options": [
        {
          "value": "middle-left",
          "label": "Middle left"
        },
        {
          "value": "middle-center",
          "label": "Middle center"
        },
        {
          "value": "bottom-left",
          "label": "Bottom left"
        },
        {
          "value": "bottom-center",
          "label": "Bottom center"
        }
      ],
      "default": "middle-left"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_indicator",
      "label": "Show scroll indicator",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors and overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent color",
      "default": "#B5F34A"
    }
  ],
  "presets": [
    {
      "name": "CHETX Video Hero"
    }
  ]
}
{% endschema %}
